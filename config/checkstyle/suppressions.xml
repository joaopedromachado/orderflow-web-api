<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Entidades JPA, setters e builders em domain não precisam de parâmetros final. -->
    <suppress checks="FinalParameters" files="[/\\]domain[/\\].*\\.java$"/>
</suppressions>
